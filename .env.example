# Redis for rooms: matchmaking and the handshake. Upstash works; use its
# rediss:// (TLS) address. On Vercel, set it in the project's environment
# variables. Locally, `cargo run --bin dev` reads it from .env and keeps its
# keys under dev:, apart from the deployment's.
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# From drawme's registration for Login with Aero, which gives both at once;
# registering again replaces both. Backend only (on Vercel, project
# environment variables). The key, a k4.local.… string, is shown once and is
# secret: never commit it. Without both, nobody can sign in. The dev server
# doesn't need them: it has a local stand-in for Aero's consent screen.
# AERO_CLIENT_ID=…
# AERO_LOGIN_KEY=k4.local.…

# Optional: a TURN relay, for people on networks that block direct connections.
# TURN_PROVIDER picks whose, one at a time: metered, cloudflare or none. Unset,
# or when the provider's settings below are missing or it doesn't answer,
# browsers connect with STUN only.
# TURN_PROVIDER=metered

# Metered: the app's name, as its dashboard shows it (the part before
# .metered.live), and the API key of a credential made there (Add Credential,
# then Show API Key: a short hex string). Not the Secret Key on the Developers
# page, which is a different, powerful key that Metered answers with "Invalid
# API Key" here. Its free plan is 500 MB a month, counted both ways.
# METERED_APP=…
# METERED_API_KEY=…

# Cloudflare: a TURN key from its Realtime dashboard, which asks for billing
# details. The key is minted into short-lived credentials on the server.
# TURN_KEY_ID=…
# TURN_KEY_API_TOKEN=…

# Where `cargo run --bin dev` listens.
# LISTEN=127.0.0.1:8787

# Only for `cargo test`: a Redis the integration tests write to, under a
# prefix of their own that they delete afterwards.
# TEST_REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
